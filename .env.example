# Optional. Otherwise connect through the local onboarding form.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Optional. Enables Jev event grouping through Vercel AI Gateway.
AI_GATEWAY_API_KEY=
# Optional. Defaults to Jev; use an AI Gateway evaluation-compatible model ID.
AI_GATEWAY_MODEL=typesafe-ai/jev
